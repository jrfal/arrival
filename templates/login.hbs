{{#> pageContainer pageTitle=signIn }}
  {{#if badCreds}}
  <div class="{{errorAlertClasses}}" role="alert">
    {{loginError}}
  </div>
  {{/if}}
  <form class="{{formClasses}}">
    {{> textField key="username" label=labelUsername requiredMessage=requiredUsername autocomplete="username"}}
    {{> textField key="password" label=labelPassword requiredMessage=requiredPassword type="password" autocomplete="current-password"}}
    <div class="{{buttonBoxClasses}}">
      {{> primaryButton}}
      {{> orDivider}}
      <div class="{{buttonStackClasses}}">
        {{> socialButtons}}
        {{> passkeyButton}}
      </div>
    </div>
  </form>
  <a href="{{forgotPWUrl}}">Forgot Password</a> &bull; <a href="{{registrationUrl}}">Register</a>
{{/pageContainer}}